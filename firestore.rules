rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: checks if a request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: checks if user is the designated admin
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.admin == true &&
        request.auth.token.email == 'ameadmriem@gmail.com' &&
        request.auth.token.email_verified == true;
    }
    
    // Movies / Anime / Episodes: Publicly readable, writeable only by Admin
    match /movies/{movieId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Sub-collections under movies if any
    match /movies/{movieId}/{document=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // User Bug / Broken Episode Reports
    match /app_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if true; // Any user can report a broken episode
      allow update, delete: if isAdmin();
    }
    
    // FCM Device Registrations
    match /fcm_devices/{deviceId} {
      allow read, write: if true;
    }
    
    // Global and Targeted Push Notifications
    match /app_notifications/{notifId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // User profile document: user can edit own profile, but cannot set role to ADMIN
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        request.resource.data.role != 'ADMIN' || isAdmin()
      );
      allow update: if isAuthenticated() && request.auth.uid == userId && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt', 'email']) || isAdmin())
      );
      allow delete: if isAdmin();
    }
    
    // User private data (favorites, my_list, history)
    match /users/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
